# Copy to .env.local for local overrides. Never commit real secrets.
# Everything prefixed with VITE_ is bundled into the public JavaScript.

# Public site URL (no trailing slash). Used for canonical, Open Graph and sitemap.
VITE_SITE_URL=

# Content provider: "demo" (local demonstration data) or "api" (future publishing API).
VITE_CONTENT_SOURCE=demo

# Future read-only public content API base URL (no credentials!).
VITE_API_BASE_URL=

# Set to "true" only when real, verified content is live.
VITE_ALLOW_INDEXING=false

# Base path. "/" for a custom domain; "/<repo>/" for https://<user>.github.io/<repo>/
BASE_PATH=/
